# OpenAI: sk-...  |  OpenRouter: sk-or-v1-...
OPENAI_API_KEY=sk-your-key-here
# Required for OpenRouter (auto-detected for sk-or- keys if left empty)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# local = FastEmbed (works with free OpenRouter keys); openai = remote embeddings
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

MCP_SERVER_URL=http://127.0.0.1:8001/mcp
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=true

# live = DuckDuckGo via FastMCP; mock = local curated corpus only
WEB_SEARCH_MODE=live
# Chroma distance threshold (lower is closer). Above this → web search.
KB_MAX_DISTANCE=1.2
KB_MIN_TOKEN_OVERLAP=1
